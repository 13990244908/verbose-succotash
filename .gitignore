# =====================================================
# 安全 / 隐私：永远不要提交的内容
# =====================================================

# 环境变量文件
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# SSH 私钥 / GitHub PAT / API tokens
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
id_dsa
id_dsa.*
*.pub
!*.pub.example
authorized_keys
known_hosts
*.token
*.pat
*_pat.txt
*_token.txt

# 凭据文件
credentials.json
gcp-service-account*.json
aws/credentials
.netrc
.pypirc

# 工作区敏感文件
secrets/
private/
drafts/

# =====================================================
# 编辑器 / IDE / 系统
# =====================================================

.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

